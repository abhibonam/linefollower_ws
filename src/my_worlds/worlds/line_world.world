<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="line_world">

    <!-- ROS2 Gazebo plugin (needed for spawn_entity service) -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <!-- Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Black line (L-shape) -->
    <model name="black_line_box1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.1 0.01</size> <!-- horizontal line -->
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <pose>0 0 0.01 0 0 0</pose>
      </link>
    </model>

    <model name="black_line_box2">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2 0.01</size> <!-- vertical line -->
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <pose>1 1 0.01 0 0 0</pose>
      </link>
    </model>

  </world>
</sdf>
